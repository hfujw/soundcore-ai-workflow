# 虚拟环境（每个开发者自己创建，不提交）
env/
venv/
.venv/

# 数据文件（运行时生成，不提交）
data/raw/
data/cleaned/
data/reports/
data/states/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/

# 前端
frontend/node_modules/
frontend/dist/

# IDE（只提交 settings.json，其他开发者本地文件忽略）
.vscode/*
!.vscode/settings.json

# 敏感配置（含API Key等，不提交）
backend/local_config.py

# 系统文件
.DS_Store
Thumbs.db

# Playwright 浏览器（每个开发者自己下载到项目内）
.playwright/
browsers/

# Python 安装目录（每个开发者自己安装）
python310/

# 安装包缓存
*.zip
*.exe
*.tar.gz
